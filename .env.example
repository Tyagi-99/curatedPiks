# Local Docker: postgresql://curated:curated@127.0.0.1:5433/curatedpicks
# Vercel: Neon pooled URI, sslmode=require
DATABASE_URL="postgresql://curated:curated@127.0.0.1:5433/curatedpicks"
# Signs the admin session cookie. 32+ chars: openssl rand -base64 32
AUTH_SECRET=""
ADMIN_EMAIL="admin@dealduniya.in"
# Only used when the admin account does not exist yet. Never committed.
# Generate one: openssl rand -base64 24
ADMIN_PASSWORD=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional AdSense. Leave blank and no Google script is loaded at all.
# Set the publisher ID plus the real numeric slot IDs from your AdSense
# dashboard. A slot renders nothing until both its ID and the client are set.
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADSENSE_SLOT_AFTER_CTA=""
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=""
# Optional. Directory for admin image uploads. Point this at a persistent
# volume in production; the default is per-instance and cleared on restart.
UPLOAD_DIR=""
# Server-only CMS URL prefix (no leading slash). Never NEXT_PUBLIC_.
ADMIN_BASE_PATH=""
