# Local Docker: postgresql://curated:curated@127.0.0.1:5433/curatedpicks
# Vercel: Neon pooled URI, sslmode=require
DATABASE_URL="postgresql://curated:curated@127.0.0.1:5433/curatedpicks"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
ADMIN_EMAIL="admin@curatedpicks.local"
ADMIN_PASSWORD="ChangeMe123!"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional. When set, AdSense slots render on public pages.
# NOTE: the AdSense loader script is not implemented yet, so slots stay empty.
NEXT_PUBLIC_ADSENSE_CLIENT=""
# Optional. Directory for admin image uploads. Point this at a persistent
# volume in production; the default is per-instance and cleared on restart.
UPLOAD_DIR=""
