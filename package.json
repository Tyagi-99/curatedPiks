{
  "name": "curatedpicks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000 --hostname 0.0.0.0",
    "build": "node ./scripts/build.mjs",
    "start": "next start --port 3000 --hostname 0.0.0.0",
    "lint": "eslint",
    "test": "node --test \"src/**/*.test.ts\"",
    "admin:password": "tsx prisma/set-admin-password.ts",
    "demo:status": "tsx prisma/demo-content.ts status",
    "demo:unpublish": "tsx prisma/demo-content.ts unpublish",
    "demo:publish": "tsx prisma/demo-content.ts publish",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "next": "16.3.1",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.9"
}
